<mujoco model="my_robot">

    <option timestep="0.01" gravity="0 0 -9.81"/>

    <default>
        <geom friction="1 0.005 0.0001"/>
    </default>

    <visual>
        <quality shadowsize="4096"/>
        <headlight diffuse="0.4 0.4 0.4" ambient="0.25 0.25 0.25" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="-130" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.08 0.12 0.16" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
    </asset>

    <worldbody>
        <geom name="ground" type="plane" size="0 0 0.1" material="groundplane"/>
        <light directional="true" pos="0 0 10" dir="-0.3 0.1 -0.9" diffuse="0.6 0.6 0.6" specular="0 0 0" castshadow="true"/>
    </worldbody>

</mujoco>