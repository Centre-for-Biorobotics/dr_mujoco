<mujoco model="my_robot">
    <option timestep="0.01" gravity="0 0 -9.81"/>
    <default>
        <geom friction="1 0.005 0.0001" />
    </default>

    <visual>
        <quality shadowsize="4096"/>
        <headlight diffuse="0.4 0.4 0.4" ambient="0.25 0.25 0.25" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="-130" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>

        <material name="MatTurquoise" rgba="0.25 0.88 0.82 1"/>
        <material name="MatIndigo" rgba="0.29 0 0.51 1"/>
        <material name="MatBlue" rgba="0.1 0.1 0.8 1"/>
        <material name="MatGreen" rgba="0.1 0.8 0.1 1"/>
        <material name="MatBarrel" rgba="1 0.65 0 1"/>
        <material name="MatRed" rgba="1 0.1 0.1 1"/>
    </asset>

    <worldbody>
        <light pos="0 0 10" dir="0 0 -1" directional="true" diffuse="0.4 0.4 0.4" castshadow="false"/>
        <light pos="5 -3 8" dir="0.2 0.1 -1" directional="false" cutoff="55" exponent="8" diffuse="0.7 0.7 0.7" specular="0.1 0.1 0.1" castshadow="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>


        <body name="turquoise_sphere" pos="10.66794 -3.03143 0.5">
            <joint type="free"/>
            <geom type="sphere" size="0.5" material="MatTurquoise" mass="1"/>
        </body>

        <body name="indigo_sphere" pos="5 0 0.6">
            <joint type="free"/>
            <geom type="sphere" size="0.6" material="MatIndigo" mass="1"/>
        </body>

        <body name="blue_cylinder" pos="4.40257 2.5337 0.5">
            <joint type="free"/>
            <geom type="cylinder" size="0.5 0.5" material="MatBlue" mass="1"/>
        </body>

        <body name="green_box" pos="5.94117 -4.31015 0.5">
            <joint type="free"/>
            <geom type="box" size="0.5 0.5 0.5" material="MatGreen" mass="1"/>
        </body>

        <body name="barrel" pos="6.08969 -2.16086 0.8">
            <joint type="free"/>
            <geom type="cylinder" size="0.3 0.8" material="MatBarrel" mass="10"/>
        </body>

        <body name="moving_ball" pos="7 0 0.5">
            <joint name="ball_slider" type="slide" axis="0 1 0" range="-20 20"/>
            <geom type="sphere" size="0.3" material="MatRed"/>
        </body>


    </worldbody>

    <actuator>
        <position name="ball_actuator" joint="ball_slider" kp="100"/>
    </actuator>

</mujoco>