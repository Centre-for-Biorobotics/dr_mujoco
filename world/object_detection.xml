<mujoco model="my_robot">
  <option timestep="0.01" gravity="0 0 -9.81"/> 
  <default>
    <geom friction="1 0.005 0.0001" />
  </default>

  <asset>
    <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .15 .2"
        width="512" height="512"/>
    <material name="MatPlane" texture="texplane" texrepeat="1 1" texuniform="true"/>
    
    <material name="MatTurquoise" rgba="0.25 0.88 0.82 1"/>
    <material name="MatIndigo" rgba="0.29 0 0.51 1"/>
    <material name="MatBlue" rgba="0.1 0.1 0.8 1"/>
    <material name="MatGreen" rgba="0.1 0.8 0.1 1"/>
    <material name="MatBarrel" rgba="1 0.65 0 1"/> 
    <material name="MatRed" rgba="1 0.1 0.1 1"/>
    </asset>

  <worldbody>
    <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="25 25 0.1" rgba=".9 .9 .9 1"/>

    <light directional="true" pos="0 0 10" dir="-0.5 0.1 -0.9" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" castshadow="true"/>

    <body name="turquoise_sphere" pos="10.66794 -3.03143 0.5">
      <joint type="free"/>
      <geom type="sphere" size="0.5" material="MatTurquoise" mass="1"/>
    </body>

    <body name="indigo_sphere" pos="8 0 0.5">
      <joint type="free"/>
      <geom type="sphere" size="0.5" material="MatIndigo" mass="1"/>
    </body>

    <body name="blue_cylinder" pos="4.40257 2.5337 0.5">
      <joint type="free"/>
      <geom type="cylinder" size="0.5 0.5" material="MatBlue" mass="1"/>
    </body>

    <body name="green_box" pos="5.94117 -4.31015 0.5">
      <joint type="free"/>
      <geom type="box" size="0.5 0.5 0.5" material="MatGreen" mass="1"/>
    </body>

    <body name="barrel" pos="6.08969 -2.16086 0.5">
      <joint type="free"/>
      <geom type="cylinder" size="0.3 0.5" material="MatBarrel" mass="10"/>
    </body>
    
    <body name="moving_ball" pos="7 0 0.5">
      <joint name="ball_slider" type="slide" axis="0 1 0" range="-20 20"/>
      <geom type="sphere" size="0.3" material="MatRed"/>
    </body>


  </worldbody> 
  
   <actuator>
    <position name="ball_actuator" joint="ball_slider" kp="100"/>
  </actuator>
 
</mujoco>